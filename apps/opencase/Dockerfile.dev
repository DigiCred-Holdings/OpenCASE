# Development Dockerfile for OpenCASE
# Runs ts-node-dev. Source is baked into the image (no host bind mounts required)
# so this works on Railway and other platforms that cannot mount local paths.
#
# Local hot-reload: optionally bind-mount ./src over /app/src in compose
# (see docker-compose.dev.yml comments). Without mounts, rebuild the image
# after code changes.

FROM node:22-alpine

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package.json package-lock.json* ./

RUN npm install

# Bake application sources (previously mounted as volumes in compose.dev)
COPY tsconfig.json ./
COPY schemas ./schemas
COPY scripts ./scripts
COPY src ./src

# Persistable data dir (empty at build; override with a volume/volume mount at runtime)
RUN mkdir -p /app/data

EXPOSE 8080

# Run in dev mode with ts-node-dev (auto-restart when files change *inside* the container)
CMD ["npm", "run", "dev"]
